# Dr. Gandhi's Dental Avenue - Environment Configuration
# Copy this file to .env and fill in your actual values

# Twilio SMS Configuration
# Get these from https://console.twilio.com/
REACT_APP_TWILIO_ACCOUNT_SID=your_twilio_account_sid
REACT_APP_TWILIO_AUTH_TOKEN=your_twilio_auth_token
REACT_APP_TWILIO_PHONE_NUMBER=your_twilio_phone_number
REACT_APP_TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# EmailJS Configuration  
# Get these from https://www.emailjs.com/
REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
REACT_APP_EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Application Configuration
REACT_APP_CLINIC_NAME="Dr. Gandhi's Dental Avenue"
REACT_APP_SUPPORT_EMAIL=admin@dentalavenue.com
REACT_APP_SUPPORT_PHONE=+919051864455

# Security Configuration
REACT_APP_OTP_EXPIRY_MINUTES=5
REACT_APP_SESSION_TIMEOUT_MINUTES=30

# Development Configuration
REACT_APP_DEMO_MODE=true
REACT_APP_DEBUG_MODE=false
